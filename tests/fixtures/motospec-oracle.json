{
  "_what": "Real MotoSPEC v5 output, used as an oracle for the geometry chain.",
  "_provenance": {
    "origin": "Vendor's own CHM help-manual screenshots, shipped inside the freely downloadable MotoSpec v5 installer. NOT the paid per-model chassis files.",
    "attribution": "MotoSpec is a product of Moto Race Services (motospec.ca). These figures are reproduced here for interoperability testing, with attribution. They are also independently measurable: every quantity is a physical property of a real motorcycle that anyone with the bike and a tape measure can obtain.",
    "why_public": "This repository is open source so that chassis-setup information is easier to get hold of, not harder. The source screenshots ship inside the freely downloadable v5 installer and are already findable online.",
    "extracted_by": "A separate read-only research workspace (~/motospec_v5_unpacked/motospec_chassis_data), which transcribed the panel values BY EYE from the screenshots.",
    "accuracy_warning": "Every number here was read off a screenshot by a human. Source values are 1-2 decimal places, so ~0.05 of rounding is baked in. On a mismatch, re-read the screenshot before suspecting the solver."
  },
  "_method": {
    "static_inputs": "Column 1 of each file is TOPPED OUT, so its outputs ARE the static state: rake -> Rake_Static, wheelbase -> WB, swingarm angle -> beta_static.",
    "Rf": "Derived from the column-1 ground-trail identity, Rf = (trail*cos(rake) + yoke) / sin(rake). The tire library from the same screenshot set is recorded as an independent cross-check only.",
    "load_case": "MotoSPEC front potentiometer = fork compression along the fork axis = our Sag_Front. Our Sag_Rear is VERTICAL wheel travel, so it takes MotoSPEC's rear_wheel_travel OUTPUT, not its rear pot reading.",
    "not_checked": "Wheel rates/forces are absent: MotoSPEC includes the fork air spring and cartridge, which this tool does not model (see the \"what this tool does not compute\" guide section). Anti-squat is absent: none of these screenshots show the CofG."
  },
  "_tiers": {
    "static": {
      "note": "Column 1, topped out. Must reproduce essentially exactly.",
      "angle_deg": 0.02,
      "length_mm": 0.15
    },
    "working": {
      "note": "Fork travel <= 40 mm, i.e. the sag/ride range this tool is built for.",
      "angle_deg": 0.06,
      "length_mm": 0.6
    },
    "deep": {
      "note": "Fork travel > 40 mm. Our flat-plate pitch model under-predicts chassis pitch here and the error grows; these bounds PIN THE KNOWN DIVERGENCE so it cannot silently get worse. They are not a pass.",
      "envelope": {
        "MotoSPEC_Rake": 1.8,
        "MotoSPEC_Trail": 23,
        "Normal_Trail": 19,
        "Swingarm_Angle": 1.6,
        "Rear_Ride_Height": 17,
        "Wheelbase_Live": 2.6
      }
    }
  },
